# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Payload — used to sign JWTs and cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# MongoDB Atlas connection string.
# Use a SEPARATE database for preview/production. See PRD §9.
DATABASE_URI=mongodb://127.0.0.1/proffer-aid

# Public site origin, no trailing slash. Used for sitemap, OG tags, and
# Paystack callback URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media storage — AWS S3 (PRD §9)
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom endpoint for S3-compatible providers (R2, MinIO).
S3_ENDPOINT=
#
# OPTIONAL — leave blank unless you deliberately want direct-from-S3 serving.
#
# By default @payloadcms/storage-s3 keeps the bucket PRIVATE and serves files
# through Payload's own route (/api/media/file/<filename>). That works out of
# the box, needs no public bucket, and next/image handles it as a same-origin
# path — so this variable is not required.
#
# Only set it if you switch the adapter to disablePayloadAccessControl: true,
# which returns direct S3/CDN URLs instead. Then the value is the bucket's
# public origin with no trailing slash:
#   https://<bucket>.s3.<region>.amazonaws.com     (public bucket)
#   https://<distribution>.cloudfront.net          (CloudFront, preferred)
#   https://media.profferaid.com                   (custom CDN domain)
# Find it in the AWS console: S3 -> your bucket -> Objects -> click any object
# -> "Object URL", then drop the object key from the end.
NEXT_PUBLIC_S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Email — Resend (PRD §9)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender on profferaid.com. Distinct from the *recipient*, which is
# the CMS-editable notificationEmail field in SiteSettings.
EMAIL_FROM_ADDRESS=noreply@profferaid.com
EMAIL_FROM_NAME=Proffer Aid International Foundation
# Fallback recipient if SiteSettings.notificationEmail is unset.
EMAIL_FALLBACK_RECIPIENT=info@profferaid.com

# ---------------------------------------------------------------------------
# Donations — Paystack (PRD §8)
# Build runs against a TEST-mode account. Cutover to PAIF's live account is a
# swap of these three values plus registering the production webhook URL.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with the SECRET key, so no separate webhook secret
# exists. This flag records which mode the keys belong to, and is written onto
# every Donation record so test traffic can never contaminate a public total.
PAYSTACK_MODE=test
